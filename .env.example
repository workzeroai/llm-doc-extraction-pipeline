# .env.example — 복사해서 .env 로 쓴다(.env는 커밋 금지).
# 키가 모두 비어 있으면 모의 추출기(규칙·정규식 기반, LLM 아님)로만 실행된다.
# 실제 LLM을 쓰려면 아래 중 하나를 채우고: pip install -e ".[llm]" → docpipe demo --provider gemini

# Gemini (--provider gemini)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Claude (--provider anthropic)
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5-5
ANTHROPIC_EFFORT=low

# OpenAI (--provider openai)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini

# 확인 대기열 알림 웹훅(선택, Slack·Discord 수신 웹훅). 비우면 콘솔 알림만
DOCPIPE_WEBHOOK_URL=

# PDF 생성용 한글 TrueType 글꼴(선택). 비우면 Pretendard → 나눔고딕 → 맑은 고딕 순으로 찾는다
DOCGEN_FONT=
DOCGEN_FONT_BOLD=
