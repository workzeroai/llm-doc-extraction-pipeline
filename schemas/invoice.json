{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/workzeroai/llm-doc-extraction-pipeline/schemas/invoice.json",
  "title": "청구서",
  "description": "청구서에서 뽑는 값. 문서에 없는 값은 null(추측 금지).",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "invoice_no",
    "issue_date",
    "due_date",
    "supplier_name",
    "supplier_biz_no",
    "buyer_name",
    "buyer_biz_no",
    "items",
    "subtotal",
    "vat",
    "total",
    "memo"
  ],
  "properties": {
    "invoice_no": {
      "type": [
        "string",
        "null"
      ],
      "title": "청구번호"
    },
    "issue_date": {
      "type": [
        "string",
        "null"
      ],
      "format": "date",
      "title": "발행일",
      "description": "YYYY-MM-DD"
    },
    "due_date": {
      "type": [
        "string",
        "null"
      ],
      "format": "date",
      "title": "납부기한",
      "description": "YYYY-MM-DD"
    },
    "supplier_name": {
      "type": [
        "string",
        "null"
      ],
      "title": "공급자"
    },
    "supplier_biz_no": {
      "type": [
        "string",
        "null"
      ],
      "pattern": "^\\d{3}-\\d{2}-\\d{5}$",
      "title": "공급자 사업자등록번호",
      "description": "000-00-00000"
    },
    "buyer_name": {
      "type": [
        "string",
        "null"
      ],
      "title": "공급받는자"
    },
    "buyer_biz_no": {
      "type": [
        "string",
        "null"
      ],
      "pattern": "^\\d{3}-\\d{2}-\\d{5}$",
      "title": "공급받는자 사업자등록번호",
      "description": "000-00-00000"
    },
    "items": {
      "type": [
        "array",
        "null"
      ],
      "title": "품목",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "name",
          "qty",
          "unit_price",
          "amount"
        ],
        "properties": {
          "name": {
            "type": "string",
            "title": "품목명"
          },
          "qty": {
            "type": "integer",
            "title": "수량"
          },
          "unit_price": {
            "type": "integer",
            "title": "단가"
          },
          "amount": {
            "type": "integer",
            "title": "금액"
          }
        }
      }
    },
    "subtotal": {
      "type": [
        "integer",
        "null"
      ],
      "title": "공급가액",
      "description": "원 단위 정수"
    },
    "vat": {
      "type": [
        "integer",
        "null"
      ],
      "title": "세액",
      "description": "원 단위 정수"
    },
    "total": {
      "type": [
        "integer",
        "null"
      ],
      "title": "청구금액 합계",
      "description": "원 단위 정수"
    },
    "memo": {
      "type": [
        "string",
        "null"
      ],
      "title": "비고"
    }
  },
  "x-required-values": [
    "invoice_no",
    "issue_date",
    "due_date",
    "supplier_name",
    "supplier_biz_no",
    "buyer_name",
    "items",
    "subtotal",
    "vat",
    "total"
  ]
}
