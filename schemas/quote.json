{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/workzeroai/llm-doc-extraction-pipeline/schemas/quote.json",
  "title": "견적서",
  "description": "견적서에서 뽑는 값. 문서에 없는 값은 null(추측 금지).",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "quote_no",
    "issue_date",
    "valid_until",
    "supplier_name",
    "supplier_biz_no",
    "client_name",
    "manager",
    "items",
    "subtotal",
    "vat",
    "total"
  ],
  "properties": {
    "quote_no": {
      "type": [
        "string",
        "null"
      ],
      "title": "견적번호"
    },
    "issue_date": {
      "type": [
        "string",
        "null"
      ],
      "format": "date",
      "title": "견적일",
      "description": "YYYY-MM-DD"
    },
    "valid_until": {
      "type": [
        "string",
        "null"
      ],
      "format": "date",
      "title": "유효기한",
      "description": "YYYY-MM-DD"
    },
    "supplier_name": {
      "type": [
        "string",
        "null"
      ],
      "title": "공급자"
    },
    "supplier_biz_no": {
      "type": [
        "string",
        "null"
      ],
      "pattern": "^\\d{3}-\\d{2}-\\d{5}$",
      "title": "공급자 사업자등록번호",
      "description": "000-00-00000"
    },
    "client_name": {
      "type": [
        "string",
        "null"
      ],
      "title": "수신(고객)"
    },
    "manager": {
      "type": [
        "string",
        "null"
      ],
      "title": "담당자"
    },
    "items": {
      "type": [
        "array",
        "null"
      ],
      "title": "품목",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "name",
          "qty",
          "unit_price",
          "amount"
        ],
        "properties": {
          "name": {
            "type": "string",
            "title": "품목명"
          },
          "qty": {
            "type": "integer",
            "title": "수량"
          },
          "unit_price": {
            "type": "integer",
            "title": "단가"
          },
          "amount": {
            "type": "integer",
            "title": "금액"
          }
        }
      }
    },
    "subtotal": {
      "type": [
        "integer",
        "null"
      ],
      "title": "공급가액 합계",
      "description": "원 단위 정수"
    },
    "vat": {
      "type": [
        "integer",
        "null"
      ],
      "title": "부가세",
      "description": "원 단위 정수"
    },
    "total": {
      "type": [
        "integer",
        "null"
      ],
      "title": "총 견적금액",
      "description": "원 단위 정수"
    }
  },
  "x-required-values": [
    "quote_no",
    "issue_date",
    "supplier_name",
    "client_name",
    "items",
    "subtotal",
    "vat",
    "total"
  ]
}
